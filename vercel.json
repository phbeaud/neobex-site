    { "source": "/policies/:path*", "destination": "https://shop.neobex.ca/policies/:path*", "statusCode": 301 },
    { "source": "/blogs/:path*", "destination": "https://shop.neobex.ca/blogs/:path*", "statusCode": 301 },
    { "source": "/cart", "destination": "https://shop.neobex.ca/cart", "statusCode": 301 },
    { "source": "/account/:path*", "destination": "https://shop.neobex.ca/account/:path*", "statusCode": 301 }
