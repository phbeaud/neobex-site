    { "source": "/en/pages/carriere", "destination": "/en/careers", "statusCode": 301 },
    { "source": "/pages/faqs", "destination": "/faq", "statusCode": 301 },
    { "source": "/en/pages/faqs", "destination": "/en/faq", "statusCode": 301 },
    { "source": "/pages/disposable-glove-guide", "destination": "/fournisseur-gants", "statusCode": 301 },
    { "source": "/en/pages/disposable-glove-guide", "destination": "/en/products", "statusCode": 301 },
